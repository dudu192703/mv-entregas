{
  "manifest_version": 3,
  "name": "MV Entregas — Leitor Mercado Livre",
  "version": "0.3.1",
  "description": "Sincroniza progresso com MV Entregas local, mediante ativacao.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://envios.mercadolivre.com.br/logistics/dist-ops/reports/monitoring*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}